{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pwd": "allow",
      "ls*": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny"
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "allow",
          "git status": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "pwd": "allow",
          "ls*": "allow"
        }
      }
    },
    "build": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git status": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    }
  }
}
