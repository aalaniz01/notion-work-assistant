{
  "name": "notion-work-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter @notion-work-assistant/priority-engine... build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:api",
    "dev": "pnpm build:packages && pnpm --parallel --filter @notion-work-assistant/api --filter @notion-work-assistant/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  }
}
