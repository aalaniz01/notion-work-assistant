{
  "name": "@notion-work-assistant/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@notion-work-assistant/db": "workspace:*",
    "@notion-work-assistant/domain": "workspace:*",
    "@notion-work-assistant/priority-engine": "workspace:*",
    "fastify": "5.8.5",
    "jose": "6.2.9",
    "openid-client": "6.8.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5"
  }
}
