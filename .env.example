DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/nwa
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/nwa_test

# OIDC login. Leave the entire block commented until a client is configured.
# APPLICATION_ORIGIN=http://localhost:5173
# OIDC_ISSUER=https://provider.example/tenant
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_TRANSIENT_SECRET=

# Internal Notion integration. Keep real values only in the ignored .env file.
NOTION_TOKEN=
NOTION_CLIENTS_DATABASE_ID=
NOTION_TASKS_DATABASE_ID=

# Optional property-name overrides (defaults shown).
# NOTION_CLIENT_NAME_PROPERTY=Name
# NOTION_TASK_TITLE_PROPERTY=Tarea
# NOTION_TASK_CLIENT_RELATION_PROPERTY=Clientes
# NOTION_TASK_TYPE_PROPERTY=Tipo
# NOTION_TASK_DUE_DATE_PROPERTY=Date
# NOTION_TASK_STATUS_PROPERTY=Estado
# NOTION_TASK_PRIORITY_PROPERTY=Prioridad
