{
  "name": "@notion-work-assistant/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.migrate.config.ts",
    "test:db": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notion-work-assistant/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "drizzle-kit": "0.31.10"
  }
}
